# 백엔드 포트
PORT=8787
# Ollama 서버 (기본값 그대로면 같은 맥에서 `ollama serve`)
OLLAMA_URL=http://localhost:11434
# 두 단계의 모델 (docs/adr/0006-backend-and-llm.md)
MODEL_SMALL=qwen3.5:9b
MODEL_GOOD=qwen3.8:27b
# 한 답장에 기다리는 최대 시간 (ms). 넘으면 프론트가 규칙 기반 답장을 그대로 쓴다
LLM_TIMEOUT_MS=25000

# ── 여행지 찾기 (docs/adr/0009-trip-search.md) ──
# Ollama Web Search 키. ollama.com 무료 계정 → https://ollama.com/settings/keys. 없으면 /api/trip/plan이 503
OLLAMA_API_KEY=
# 장소 추출 모델. 비우면 요청의 tier(small/good)를 따른다. 교토 드라이런에서는 27B가 더 정확했고 시간은 비슷했다
TRIP_MODEL=
# 추출 한 번에 기다리는 최대 시간 (ms)
TRIP_MODEL_TIMEOUT_MS=90000
# Nominatim(OpenStreetMap) 지오코딩. 공개 서버 정책상 연락처(이메일)를 User-Agent에 싣는다. 비우면 dev@localhost.
# example.com 같은 자리표시 주소는 403으로 막히니 진짜 연락처를 넣거나 비워 둔다. 자체 서버면 URL을 바꾼다
NOMINATIM_CONTACT=
NOMINATIM_URL=https://nominatim.openstreetmap.org
# 도시 팩 파일 캐시 (기본 backend/.cache/trip)
# TRIP_CACHE_DIR=
# 허용 origin. 기본 *. 검색 키를 서버가 쓰므로 개발 서버 주소로 좁히는 걸 권한다
CORS_ORIGIN=*
